#!/usr/bin/env sh
set -eu

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"

if [ "${ALLOW_MAIN_BRANCH:-}" = "1" ]; then
  exit 0
fi

case "$branch" in
  main|master)
    echo ""
    echo "[branch-guard] Commit blocked on '$branch'."
    echo "Create a branch first:"
    echo "  git checkout -b bugfix/<area>-<issue>"
    echo "  git checkout -b feature/<area>-<feature>"
    echo ""
    echo "If this is intentional, bypass once with:"
    echo "  ALLOW_MAIN_BRANCH=1 git commit ..."
    echo "or use:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
    ;;
esac

exit 0
