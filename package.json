{
  "name": "gtaurus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build && node scripts/publish_web.js",
    "deploy:web": "node scripts/publish_web.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run tauri:build -- --debug && wdio run ./wdio.conf.ts",
    "test:rust": "cd src-tauri && cargo test",
    "wdio": "wdio run ./wdio.conf.ts",
    "postinstall": "npm run build:lib && npm run build:server && npm run build:web",
    "build:lib": "cd deps/gtaurus_lib && cargo build",
    "build:server": "cd deps/gtaurus_server && cargo build",
    "server": "cd deps/gtaurus_server && cargo run",
    "build:all": "npm run build:lib && npm run build:server && npm run build:web"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@zip.js/zip.js": "^2.8.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dockview": "^5.0.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.571.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.6.4",
    "tailwind-merge": "^3.4.1",
    "three": "^0.183.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@wdio/cli": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "@wdio/visual-service": "^9.1.4",
    "autoprefixer": "^10.4.24",
    "expect-webdriverio": "^5.6.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18",
    "webdriverio": "^9.24.0"
  }
}
